<DIAGINST id='_000002718657F000' oid='5173D7185FAB449b8F980917F22C5BCC' tmplref='_00000271860B7020' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>checkProgrammingDependencies - FlashChecksum</TUV>
<TUV xml:lang='it'>checkProgrammingDependencies - FlashChecksum</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC b='1' fs='180'>TBD:: change to "check Programming Dependencies - Validate Application" (CS.102)</FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
<TUV xml:lang='it' uptodate='0' struct='1'><PARA><FC b='1' fs='180'>NOTE</FC>
</PARA>
<PARA><FC fs='180'>SGW always returns a positive response to routine $FF01 regardless of what memory range is requested, ignoring the checksum value sent by the tool.</FC>
</PARA>
<PARA><FC fs='180'>The SGW fully authenticates the contents of any flash data once it is received against both its certificate store and the hash value contained in the logical block header to ensure that the contents of the data received by the module match the contents of the data that was signed by the PKI. SGW always performs this process immediately upon receipt of the data without any additional prompting by any tool, so the checksum request that the tool sends does not add any value to the process</FC>
<FC tcol='8210719' fs='180'>.</FC>
</PARA>
</TUV>
</DESC>
<QUAL>checkProgrammingDependencies_FlashChecksum</QUAL>
<SERVICE id='_0000027187548EF0' oid='7B5F2E948321423bB79157551D3D0976' tmplref='_0000027186084C60' func='1' phys='1' respOnPhys='1' respOnFunc='1' xaud='4' req='0' mayBeExec='(2,3,4,5,6,8)'>
