</SERVICE>
<STATICVALUE oid='78603BBA09DE4e8b98F7FCA0A95C3A61' temploid='77F9881DA32E40e8A6A7DE58787B0EAC' shstaticref='_0000027186177F50' v='10'/>
<SIMPLECOMPCONT oid='8CF4ACBBBFB746a7A9DF71342D3EA622' temploid='EE67481C289D4eb0B2825328BBFD7407' shproxyref='_00000271860B9220'>
<DATAOBJ oid='8161E6F3800347819BCAA86ECE36F8CC' temploid='BE5ED235FBCD4c838F924D959AC6409C' spec='no' v='1' dtref='_0000027182C4A5B0'>
<NAME>
<TUV xml:lang='en-US'>NumberOfDataItems</TUV>
<TUV xml:lang='it'>NumberOfDataItems</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>This parameter defines the number of data items included in the response message which are identified and
belong to the InfoType reported. For example, a request message with the InfoType for CVN (Calibration
Verification Number) may cause the ECU to send a response message, that contains multiple CVNs. The amount
of CVNs is included in the “Number of data items” parameter</TUV>
<TUV xml:lang='it'>Questo parametro definisce il numero di data items inclusi nel messaggio di risposta che sono identificati e 
appartengono all'InfoType riportato. Per esempio, un messaggio di richiesta con InfoType per CVN (Calibration
Verification Number) può comportare che la ECU invii un messaggio di risposta che contiene multipli CVN. La quantità 
di CVN è inclusa nel parametro "Numero di data items".</TUV>
</DESC>
<QUAL>NumberOfDataItems</QUAL>
</DATAOBJ>
<DATAOBJ oid='BC5C53A4FA4D46a7AEBACD0C8B4CDA61' temploid='6B6CA30208624215AA93845590FEE9DB' spec='no' dtref='_0000027182C45ED0'>
<NAME>
<TUV xml:lang='en-US'>ECUNAME</TUV>
<TUV xml:lang='it' uptodate='0'>MessageCount CALID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'></TUV>
<TUV xml:lang='it' uptodate='0'>number of message for calibration value define
(CALID)</TUV>
</DESC>
<QUAL>ECUNAME</QUAL>
</DATAOBJ>
