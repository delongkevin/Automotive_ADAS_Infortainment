<DIAGINST id='_0000027187DA76F0' oid='804116B375A949a4A27E2D164C61F3A8' temploid='E1844A24437348eaAEE207271386586F' tmplref='_00000271860B9330' act='0' xaud='32' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>MessageCount ECUNAME</TUV>
<TUV xml:lang='it' uptodate='0'>MessageCount CALID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC></FC>
</PARA>
</TUV>
<TUV xml:lang='it' uptodate='0' struct='1'><PARA><FC>ECU response at request PID $03 of service $09 is follow descrive:</FC>
</PARA>
<PARA list='bul'><FC>Tx 2 (bytes)	F1-&#62;33 : 09 03 </FC>
</PARA>
<PARA list='bul'><FC>Rx 4 (bytes)	10-&#62;F1 : 49 03 01 01 </FC>
</PARA>
<PARA><FC>That means:</FC>
</PARA>
<PARA list='bul'><FC>Number Of Data Items = 01</FC>
</PARA>
<PARA list='bul'><FC>Message Count CALID = 01</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1'>Number Of Data Items:</FC>
</PARA>
<PARA><FC>This parameter defines the number of data items included in the response message which are identified and belong to the InfoType reported;</FC>
</PARA>
<PARA><FC>In ECU Marelli 6F3, a request message with the InfoType $03 for MessageCountCALID, the response is positive with $01 value because the message is included into anly one message</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1'>Message Count CALID:</FC>
</PARA>
<PARA><FC>Number of messages to report calibration identifications</FC>
</PARA>
<PARA><FC>Support for ISO 15765-4 is not required for the ECU and the external test equipment. In For ECU Marelli 6F3 the response is positive con message Count CALID = $01, that means the CALID is included in only one message</FC>
</PARA>
</TUV>
</DESC>
<QUAL>MessageCount_ECUNAME</QUAL>
