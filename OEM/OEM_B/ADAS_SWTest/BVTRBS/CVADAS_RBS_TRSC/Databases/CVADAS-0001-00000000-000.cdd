<DIAGINST id='_00000271882A1AF0' oid='5C93C445C5B44118ABF2FD2B38B8683E' temploid='EFE72A66FD0E43dc89C4CF6849C194A7' tmplref='_00000271860B9330' act='0' xaud='32' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>Supported PIDs from $01 to $20</TUV>
<TUV xml:lang='it'>PID supportati da $01 a $20</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
<TUV xml:lang='it' uptodate='0' struct='1'><PARA><FC b='1'>PID $00 service $09: </FC>
</PARA>
<PARA><FC b='1'>A[50] B[20] C[00] D[00]</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>ECU response at request PID $00 of service $09 is follow descrive:</FC>
</PARA>
<PARA list='bul'><FC>Tx 2 (bytes)	F1-&#62;33 : 09 00 </FC>
</PARA>
<PARA list='bul'><FC>Rx 6 (bytes)	10-&#62;F1 : 49 00 F0 00 00 00 </FC>
</PARA>
<PARA><FC>same response for request 6 Bytes (PIDs encoded Bit) in the request</FC>
</PARA>
<PARA list='bul'><FC>Tx 7 (bytes)	F1-&#62;33 : 09 00 20 40 60 80 </FC>
</PARA>
<PARA list='bul'><FC>Rx 6 (bytes)	10-&#62;F1 : 49 00 F0 00 00 00 </FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1'>Supported PIDs range $01..$20 [$09 - PID 00]  	 0xF0000000</FC>
</PARA>
<PARA><FC>	    Supported Pids DATA A..D </FC>
</PARA>
<PARA list='bul'><FC>DATA A Bit 6 (PID </FC>
<FC b='1'>$02</FC>
<FC>) = supported</FC>
</PARA>
<PARA list='bul'><FC>DATA A Bit 4 (PID </FC>
<FC b='1'>$04</FC>
<FC>) = supported</FC>
</PARA>
<PARA list='bul'><FC>DATA B Bit 5 (PID </FC>
<FC b='1'>$0B</FC>
<FC>) = supported</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC></FC>
</PARA>
</TUV>
</DESC>
<QUAL>Supported_PIDs_from_01_to_20</QUAL>
