<DIAGINST id='_000002718829F3F0' oid='2BD3A598D54E4bc2957EDBB516DEC9B5' temploid='0A4A4A5E383B43599BEBB597CA19EC76' tmplref='_00000271860B9330' act='0' xaud='32' req='notReq'>
<NAME>
<TUV xml:lang='en-US'>Vehicle Identification Number (VIN)</TUV>
<TUV xml:lang='it'>Vehicle Identification Number (VIN)</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'></TUV>
<TUV xml:lang='it' uptodate='0' struct='1'><PARA><FC>ECU response at request PID $02 of service $09 is follow descrive:</FC>
</PARA>
<PARA list='bul'><FC>Tx 2 (bytes)	F1-&#62;33 : 09 02 </FC>
</PARA>
<PARA list='bul'><FC>Rx 20 (bytes)	10-&#62;F1 : 49 02 01 + 17 bytes ASCII Code </FC>
</PARA>
<PARA><FC>That means:</FC>
</PARA>
<PARA list='bul'><FC>Number Of Data Items = 01</FC>
</PARA>
<PARA list='bul'><FC>Vehicle Identification Number = 17 bytes value contents</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1'>Number Of Data Items:</FC>
</PARA>
<PARA><FC>This parameter defines the number of data items included in the response message which are identified and belong to the InfoType reported;</FC>
</PARA>
<PARA><FC>In ECU Marelli 6F3, a request message with the InfoType $02 for VIN , the response is positive with $01 value because the VIN contents is included into anly one message</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC b='1'>Vehicle Identification Number:</FC>
</PARA>
<PARA><FC>For vehicles that provide electronic access to the VIN, it is recommended to report it using this format for ease of use by the external test equipment intended either for vehicle diagnostics or Inspection/Maintenance programmes.</FC>
</PARA>
<PARA><FC>For ISO 15765-4 there is only one response message, which contains all VIN characters without any filling bytes</FC>
</PARA>
<PARA><FC></FC>
</PARA>
<PARA><FC>In ECU Marelli 6F3 the contents of VIN is same of RDI F190</FC>
</PARA>
</TUV>
</DESC>
<QUAL>Vehicle_Identification_Number_VIN</QUAL>
<SERVICE id='_00000271881A0060' oid='3A9DAC838E37479cA71A6616740BE7F5' temploid='FAF4CE0A73404a9aA4BB02251BD6B207' tmplref='_00000271860F8430' func='1' phys='0' respOnPhys='0' respOnFunc='1' xaud='32' req='0'>
