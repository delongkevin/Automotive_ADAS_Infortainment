<TUV xml:lang='it'>Vehicle Info</TUV>
</NAME>
<QUAL>Vehicle_Info</QUAL>
<SHORTCUTNAME>
<TUV xml:lang='en-US'>Calibration Identifications Vehicle Info</TUV>
<TUV xml:lang='it'>Identificativi di calibrazione Vehicle Info</TUV>
</SHORTCUTNAME>
<SHORTCUTQUAL>Identificativi_di_calibrazione_Vehicle_Info</SHORTCUTQUAL>
</SERVICE>
<STATICVALUE oid='AA94F0A070114926958B39E1E1389023' temploid='725D5AC49CAC463cB9430F3B9B80E73C' shstaticref='_0000027186177F50' v='4'/>
