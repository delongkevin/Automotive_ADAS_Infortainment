<ENUMDEF id='_00000271829B8B90' oid='1EA3769142E64b66B3B319DCFE8199E2' temploid='027C661F0D604ba297FBA2439C769DA9' attrcatref='_0000027182560FB0' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>MainHandlerSupport (on Service Level)</TUV>
<TUV xml:lang='it' uptodate='0'></TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Provide MainHandler for current Service (Service/Subfunction combination).
Restriction: Only evaluated if Folder attribute 'MainHandlerSupport (on Protocol Service Level)' is not set, i.e. equals to 'none'.</TUV>
<TUV xml:lang='it' uptodate='0'></TUV>
</DESC>
<QUAL>MainHandlerSupport</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>user</TUV>
