<ENUMDEF id='_000002718297DDF0' oid='51C25141603D4af89FEBE3C842DE5FBB' temploid='427B883FA6944e79B1D5B8D7356C0D31' attrcatref='_0000027182560B30' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Diagnostic DoIP (ISO13400:2012)</TUV>
<TUV xml:lang='it'>Diagnostic DoIP (ISO13400:2012)</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Communication interface for Diagnostics over IP (DoIP) protocol. Based on the specification: ISO13400-2:2012 "Road vehicles — Diagnostic communication over Internet Protocol(DoIP) — Part 2: Network and transport layer requirements and services" and the referenced ISO22900-2 (D-PDU API) for ComParam qualifiers.</TUV>
<TUV xml:lang='it'>Communication interface for Diagnostics over IP (DoIP) protocol. Based on the specification: ISO13400-2:2012 "Road vehicles — Diagnostic communication over Internet Protocol(DoIP) — Part 2: Network and transport layer requirements and services" and the referenced ISO22900-2 (D-PDU API) for ComParam qualifiers.</TUV>
</DESC>
<QUAL>Diagnostic_DoIP_ISO13400_2012</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
<TUV xml:lang='it'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
<TUV xml:lang='it'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_000002718297DFE0' oid='B1BBB41C93654161ABF0E8F4D905D21D' temploid='96124B8D4B15494f9469BF7353F02F68' attrcatref='_00000271825623F0' usage='admin' v='0' sort='id'>
