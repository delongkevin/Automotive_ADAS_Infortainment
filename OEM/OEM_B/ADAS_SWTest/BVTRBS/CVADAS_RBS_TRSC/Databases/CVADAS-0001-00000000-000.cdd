<TUV xml:lang='it'>MessageCount CALID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'></TUV>
<TUV xml:lang='it' uptodate='0'>number of message for calibration value define
(CALID)</TUV>
</DESC>
<QUAL>MessageCount_CALID</QUAL>
</DATAOBJ>
</SIMPLECOMPCONT>
