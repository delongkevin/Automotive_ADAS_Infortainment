<SERVICE id='_000002718819C450' oid='0F965FC08DF54a2188AC5B580E4E5E38' temploid='FA5B80A634054b6bB9CB1C03719B6B8E' tmplref='_00000271860F8430' func='1' phys='0' respOnPhys='0' respOnFunc='1' xaud='32' req='0'>
